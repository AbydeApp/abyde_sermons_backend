// Abyde Sermon — persistence schema.
// Conventions: opaque UUID ids, snake_case tables/columns, every ministry-owned row carries church_id.
// Migration policy: additive, backward-compatible changes only (expand → migrate → contract); see docs/MIGRATIONS.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Extensions (vector, pg_trgm) are created in the initial migration.
}

// ───────────────────────── Enums ─────────────────────────

enum SermonStatus {
  UPLOADING
  UPLOADED
  QUEUED
  TRANSCRIBING
  ANALYZING
  INDEXING
  READY
  FAILED
  ARCHIVED
}

enum ProcessingStage {
  UPLOAD
  MEDIA
  TRANSCRIBE
  UNDERSTAND
  SCRIPTURES
  INTELLIGENCE
  INDEX
}

enum SermonSourceType {
  MEDIA
  DOCUMENT
  TEXT
}

enum UploadPurpose {
  SERMON_MEDIA
}

enum JobStatus {
  QUEUED
  PROCESSING
  RETRYING
  COMPLETED
  FAILED
}

enum ContentType {
  DEVOTIONAL
  SOCIAL_POST
  PRAYER
  BIBLE_STUDY
  EMAIL
  WHATSAPP
  QUOTE
  VIDEO_IDEA
}

enum ContentStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum ContentVersionSource {
  AI_GENERATED
  AI_REWRITE
  USER_EDIT
}

enum CalendarItemStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum PublishAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum UsageUnit {
  SERMON_PROCESSED
  CONTENT_GENERATED
  TRANSCRIPTION_MINUTE
  TEXT_GENERATION
  EMBEDDING
  IMAGE_GENERATION
  VIDEO_GENERATION
  STORAGE_BYTES
  REEL_RENDERED
  RENDER_SECOND
  SOCIAL_PUBLICATION
}

enum IntegrationProvider {
  WHATSAPP
  EMAIL
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  NEEDS_ATTENTION
}

enum MediaAssetKind {
  BRAND_LOGO
  IMAGE
  CAROUSEL_SLIDE
  VIDEO
  THUMBNAIL
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
}

enum ReelStatus {
  DRAFT
  QUEUED
  PREPARING
  CROPPING
  ADDING_HOOK
  ADDING_CAPTIONS
  BRANDING
  ENCODING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  NON_RENEWING
  PAST_DUE
  CANCELLED
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id              String    @id @db.Uuid
  fullName        String    @map("full_name")
  email           String    @unique // stored normalized (trimmed, lower-cased)
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneNumber     String?   @map("phone_number")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  church            Church?
  sessions          Session[]
  passwordResets    PasswordResetToken[]
  emailVerification EmailVerification?

  @@map("users")
}

model Session {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") // SHA-256 of the cookie token; raw token never stored
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // expiry purge
  @@map("password_reset_tokens")
}

/// One live signup/login verification code per user; replaced whenever a new one is sent.
model EmailVerification {
  userId    String   @id @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt]) // expiry purge
  @@map("email_verifications")
}

// ───────────────────────── Church ─────────────────────────

model Church {
  id                        String   @id @db.Uuid
  userId                    String   @unique @map("user_id") @db.Uuid // V1: exactly one church per user
  name                      String
  slug                      String   @unique
  ownerRole                 String   @map("owner_role")
  denomination              String?
  website                   String?
  description               String?
  preferredBibleTranslation String   @default("NIV") @map("preferred_bible_translation")
  primaryColor              String?  @map("primary_color")
  secondaryColor            String?  @map("secondary_color")
  devotionalTone            String?  @map("devotional_tone")
  socialTone                String?  @map("social_tone")
  audienceDescription       String   @default("") @map("audience_description")
  wordsToAvoid              String   @default("") @map("words_to_avoid")
  additionalAIContext       String   @default("") @map("additional_ai_context")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  uploads          Upload[]
  sermons          Sermon[]
  contentItems     ContentItem[]
  calendarItems    CalendarItem[]
  usageEvents      UsageEvent[]
  integrations     Integration[]
  subscription     Subscription?
  billingCustomer  BillingCustomer?
  usageAllowance   UsageAllowance?
  generationGroups GenerationGroup[]
  publishAttempts  PublishAttempt[]

  brandProfile       BrandProfile?
  mediaAssets        MediaAsset[]
  socialConnections  SocialConnection[]
  socialPosts        SocialPost[]
  socialPublications SocialPublication[]
  socialAuditLogs    SocialAuditLog[]
  reelCandidates     ReelCandidate[]
  reels              Reel[]

  @@map("churches")
}

// Every presigned upload is recorded so object keys sent back by the browser can be verified.
model Upload {
  id          String        @id @db.Uuid
  churchId    String        @map("church_id") @db.Uuid
  objectKey   String        @unique @map("object_key")
  purpose     UploadPurpose
  fileName    String        @map("file_name")
  contentType String        @map("content_type")
  sizeBytes   BigInt        @map("size_bytes")
  expiresAt   DateTime      @map("expires_at")
  consumedAt  DateTime?     @map("consumed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, createdAt])
  @@index([consumedAt, createdAt]) // stale-upload purge
  @@map("uploads")
}

// ───────────────────────── Sermons ─────────────────────────

model Sermon {
  id                 String           @id @db.Uuid
  churchId           String           @map("church_id") @db.Uuid
  title              String
  speaker            String
  sermonDate         DateTime         @map("sermon_date")
  series             String?
  mainScripture      String?          @map("main_scripture")
  tags               String[]         @default([])
  status             SermonStatus
  processingStage    ProcessingStage? @map("processing_stage")
  failedStage        ProcessingStage? @map("failed_stage")
  errorMessage       String?          @map("error_message")
  canRetry           Boolean          @default(false) @map("can_retry")
  sourceType         SermonSourceType @map("source_type")
  summary            String?
  mainTheme          String?          @map("main_theme")
  themes             String[]         @default([]) // denormalized from intelligence for filtering/facets
  scriptures         String[]         @default([]) // verified reference display strings
  durationMs         Int?             @map("duration_ms")
  processingAttempts Int              @default(0) @map("processing_attempts")
  readyAt            DateTime?        @map("ready_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  church           Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  assets           SermonAsset[]
  transcript       Transcript?
  segments         TranscriptSegment[]
  intelligence     SermonIntelligence?
  scriptureRefs    ScriptureReference[]
  embeddings       SermonEmbedding[]
  contentItems     ContentItem[]
  generationGroups GenerationGroup[]
  reelCandidates   ReelCandidate[]
  reels            Reel[]

  @@index([churchId, sermonDate(sort: Desc)])
  @@index([churchId, status])
  @@index([churchId, createdAt])
  @@index([tags], type: Gin)
  @@index([themes], type: Gin)
  @@index([scriptures], type: Gin)
  @@index([status, updatedAt]) // stuck-processing recovery sweep
  @@map("sermons")
}

model SermonAsset {
  id          String    @id @db.Uuid
  churchId    String    @map("church_id") @db.Uuid
  sermonId    String    @map("sermon_id") @db.Uuid
  objectKey   String    @unique @map("object_key")
  contentType String    @map("content_type")
  sizeBytes   BigInt    @map("size_bytes")
  expiresAt   DateTime? @map("expires_at") // plan source retention; null = kept (uploads made before retention existed)
  deletedAt   DateTime? @map("deleted_at") // original removed from storage; the row stays as a record
  createdAt   DateTime  @default(now()) @map("created_at")

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@index([churchId, sermonId])
  @@index([sermonId]) // FK lookups / cascade deletes
  @@index([deletedAt, expiresAt]) // retention sweep
  @@map("sermon_assets")
}

model Transcript {
  id        String   @id @db.Uuid
  churchId  String   @map("church_id") @db.Uuid
  sermonId  String   @unique @map("sermon_id") @db.Uuid
  fullText  String   @map("full_text")
  language  String?
  provider  String
  createdAt DateTime @default(now()) @map("created_at")

  sermon   Sermon              @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]

  @@index([churchId])
  @@map("transcripts")
}

model TranscriptSegment {
  id           String  @id @db.Uuid
  churchId     String  @map("church_id") @db.Uuid
  sermonId     String  @map("sermon_id") @db.Uuid
  transcriptId String  @map("transcript_id") @db.Uuid
  sequence     Int
  startTimeMs  Int     @map("start_time_ms")
  endTimeMs    Int     @map("end_time_ms")
  text         String
  speakerLabel String? @map("speaker_label")
  words        Json? // word timings as [text, startMs, endMs] tuples; null when the source had none

  sermon     Sermon     @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, sequence])
  @@index([churchId, sermonId, sequence])
  @@index([sermonId]) // FK lookups / cascade deletes
  @@map("transcript_segments")
}

model SermonIntelligence {
  id         String   @id @db.Uuid
  churchId   String   @map("church_id") @db.Uuid
  sermonId   String   @unique @map("sermon_id") @db.Uuid
  data       Json // validated SermonIntelligence document (see sermons/domain)
  aiProvider String   @map("ai_provider")
  aiModel    String   @map("ai_model")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@index([churchId])
  @@map("sermon_intelligence")
}

model ScriptureReference {
  id              String   @id @db.Uuid
  churchId        String   @map("church_id") @db.Uuid
  sermonId        String   @map("sermon_id") @db.Uuid
  book            String
  chapter         Int
  verseStart      Int?     @map("verse_start")
  verseEnd        Int?     @map("verse_end")
  translation     String?
  verified        Boolean
  display         String
  sourceSegmentId String?  @map("source_segment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@index([churchId, sermonId])
  @@index([churchId, book])
  @@index([sermonId]) // FK lookups / cascade deletes
  @@map("scripture_references")
}

model SermonEmbedding {
  id                  String                      @id @db.Uuid
  churchId            String                      @map("church_id") @db.Uuid
  sermonId            String                      @map("sermon_id") @db.Uuid
  transcriptSegmentId String?                     @map("transcript_segment_id") @db.Uuid
  content             String
  embedding           Unsupported("vector(1536)")
  metadata            Json                        @default("{}")
  createdAt           DateTime                    @default(now()) @map("created_at")

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@index([churchId, sermonId])
  @@index([sermonId]) // FK lookups / cascade deletes
  @@map("sermon_embeddings")
}

// ───────────────────────── Generation & content ─────────────────────────

model GenerationGroup {
  id        String   @id @db.Uuid
  churchId  String   @map("church_id") @db.Uuid
  sermonId  String   @map("sermon_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  church Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  sermon Sermon          @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  jobs   GenerationJob[]

  @@index([churchId, sermonId, createdAt(sort: Desc)])
  @@index([sermonId]) // FK lookups / cascade deletes
  @@map("generation_groups")
}

model GenerationJob {
  id           String      @id @db.Uuid
  groupId      String      @map("group_id") @db.Uuid
  churchId     String      @map("church_id") @db.Uuid
  sermonId     String      @map("sermon_id") @db.Uuid
  contentType  ContentType @map("content_type")
  status       JobStatus
  attempts     Int         @default(0)
  errorMessage String?     @map("error_message")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  group GenerationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, contentType]) // idempotency: one job per type per group
  @@index([churchId, status])
  @@index([status, updatedAt]) // stuck-job recovery sweep
  @@map("generation_jobs")
}

model ContentItem {
  id              String        @id @db.Uuid
  churchId        String        @map("church_id") @db.Uuid
  sermonId        String        @map("sermon_id") @db.Uuid
  generationJobId String?       @map("generation_job_id") @db.Uuid
  type            ContentType
  position        Int           @default(0) // e.g. devotional day number
  title           String
  body            String
  scripture       String?
  platform        String?
  status          ContentStatus
  scheduledAt     DateTime?     @map("scheduled_at")
  publishedAt     DateTime?     @map("published_at")
  sourceMetadata  Json          @default("{}") @map("source_metadata")
  currentVersion  Int           @default(1) @map("current_version")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  church          Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  sermon          Sermon           @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  versions        ContentVersion[]
  calendarItem    CalendarItem?
  publishAttempts PublishAttempt[]
  mediaAssets     MediaAsset[]
  socialPosts     SocialPost[]

  @@index([churchId, status])
  @@index([churchId, sermonId])
  @@index([churchId, updatedAt(sort: Desc)])
  @@index([churchId, type])
  @@index([generationJobId])
  @@index([sermonId]) // FK lookups / cascade deletes
  @@map("content_items")
}

model ContentVersion {
  id            String               @id @db.Uuid
  contentItemId String               @map("content_item_id") @db.Uuid
  version       Int
  title         String
  body          String
  scripture     String?
  source        ContentVersionSource
  aiProvider    String?              @map("ai_provider")
  aiModel       String?              @map("ai_model")
  createdAt     DateTime             @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, version])
  @@map("content_versions")
}

model CalendarItem {
  id            String             @id @db.Uuid
  churchId      String             @map("church_id") @db.Uuid
  contentItemId String             @unique @map("content_item_id") @db.Uuid
  scheduledAt   DateTime           @map("scheduled_at")
  status        CalendarItemStatus
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([churchId, scheduledAt])
  @@index([status, scheduledAt]) // due-item dispatcher
  @@map("calendar_items")
}

// ───────────────────────── Publishing & integrations ─────────────────────────

model Integration {
  id                   String              @id @db.Uuid
  churchId             String              @map("church_id") @db.Uuid
  provider             IntegrationProvider
  status               IntegrationStatus
  encryptedCredentials String?             @map("encrypted_credentials") // AES-256-GCM envelope
  externalAccountId    String?             @map("external_account_id")
  accountLabel         String?             @map("account_label")
  expiresAt            DateTime?           @map("expires_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([churchId, provider])
  @@map("integrations")
}

model PublishAttempt {
  id             String               @id @db.Uuid
  churchId       String               @map("church_id") @db.Uuid
  contentItemId  String               @map("content_item_id") @db.Uuid
  provider       IntegrationProvider
  idempotencyKey String               @unique @map("idempotency_key") // prevents duplicate publishing
  status         PublishAttemptStatus
  externalId     String?              @map("external_id")
  errorMessage   String?              @map("error_message")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([churchId, createdAt])
  @@index([contentItemId])
  @@map("publish_attempts")
}

// ───────────────────────── Usage & billing ─────────────────────────

model UsageEvent {
  id        String    @id @db.Uuid
  churchId  String    @map("church_id") @db.Uuid
  unit      UsageUnit
  quantity  Float
  sermonId  String?   @map("sermon_id") @db.Uuid
  dedupeKey String?   @unique @map("dedupe_key") // makes metering idempotent across job retries
  createdAt DateTime  @default(now()) @map("created_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, createdAt])
  @@index([churchId, unit, createdAt])
  @@map("usage_events")
}

model AIUsageLog {
  id            String   @id @db.Uuid
  churchId      String?  @map("church_id") @db.Uuid
  sermonId      String?  @map("sermon_id") @db.Uuid
  operation     String
  provider      String
  model         String
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  estimatedCost Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  latencyMs     Int      @map("latency_ms")
  status        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([churchId, createdAt])
  @@index([operation, createdAt])
  @@map("ai_usage_logs")
}

model BillingCustomer {
  id                 String   @id @db.Uuid
  churchId           String   @unique @map("church_id") @db.Uuid
  provider           String
  externalCustomerId String   @map("external_customer_id")
  createdAt          DateTime @default(now()) @map("created_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([provider, externalCustomerId])
  @@map("billing_customers")
}

model Subscription {
  id                     String             @id @db.Uuid
  churchId               String             @unique @map("church_id") @db.Uuid
  provider               String
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus
  externalSubscriptionId String?            @unique @map("external_subscription_id")
  externalEmailToken     String?            @map("external_email_token")
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageAllowance {
  id           String   @id @db.Uuid
  churchId     String   @unique @map("church_id") @db.Uuid
  planId       String   @map("plan_id")
  sermonsLimit Int      @map("sermons_limit")
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  updatedAt    DateTime @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("usage_allowances")
}

model WebhookEvent {
  id          String    @id @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@unique([provider, eventId]) // replay protection
  @@map("webhook_events")
}

// ───────────────────────── Brand Studio & media ─────────────────────────

model BrandProfile {
  id                   String   @id @db.Uuid
  churchId             String   @unique @map("church_id") @db.Uuid
  churchName           String   @map("church_name")
  logoAssetId          String?  @map("logo_asset_id") @db.Uuid
  alternateLogoAssetId String?  @map("alternate_logo_asset_id") @db.Uuid
  primaryColor         String   @map("primary_color")
  secondaryColor       String   @map("secondary_color")
  accentColor          String   @map("accent_color")
  headingFont          String   @map("heading_font")
  bodyFont             String   @map("body_font")
  socialHandle         String?  @map("social_handle")
  website              String?
  footerText           String?  @map("footer_text")
  watermarkEnabled     Boolean  @default(false) @map("watermark_enabled")
  watermarkPosition    String?  @map("watermark_position")
  voice                Json     @default("{}") // validated BrandVoice document (see brand/domain)
  templateDefaults     Json     @default("{}") @map("template_defaults") // content type → template id
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

// Uploaded brand assets and every rendered image/slide/video, with its technical metadata.
model MediaAsset {
  id            String           @id @db.Uuid
  churchId      String           @map("church_id") @db.Uuid
  sermonId      String?          @map("sermon_id") @db.Uuid
  contentItemId String?          @map("content_item_id") @db.Uuid
  kind          MediaAssetKind
  status        MediaAssetStatus
  objectKey     String           @unique @map("object_key")
  contentType   String           @map("content_type")
  sizeBytes     BigInt?          @map("size_bytes")
  width         Int?
  height        Int?
  durationMs    Int?             @map("duration_ms")
  renderGroupId String?          @map("render_group_id") @db.Uuid // assets produced by one render request
  position      Int              @default(0) // slide order within a carousel
  renderSpec    Json?            @map("render_spec") // what the worker renders (never contains secrets)
  metadata      Json             @default("{}")
  errorMessage  String?          @map("error_message")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  church      Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([churchId, contentItemId])
  @@index([churchId, renderGroupId])
  @@index([contentItemId]) // FK lookups
  @@index([status, updatedAt]) // stuck-render sweep
  @@map("media_assets")
}

// ───────────────────────── Direct social publishing ─────────────────────────
// platform/status columns hold the lowercase wire values of the social API contract
// (social/domain); they are validated in the domain, not by a database enum.

model SocialConnection {
  id                    String    @id @db.Uuid
  churchId              String    @map("church_id") @db.Uuid
  platform              String
  provider              String
  providerAccountId     String    @map("provider_account_id")
  accountName           String    @map("account_name")
  avatarUrl             String?   @map("avatar_url")
  encryptedAccessToken  String?   @map("encrypted_access_token") // AES-256-GCM envelope; null once revoked
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  scopes                String[]  @default([])
  status                String
  metadata              Json      @default("{}")
  connectedByUserId     String?   @map("connected_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  church       Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  publications SocialPublication[]

  @@unique([churchId, platform, providerAccountId])
  @@index([status, tokenExpiresAt]) // token-maintenance sweep
  @@map("social_connections")
}

model SocialPost {
  id               String    @id @db.Uuid
  churchId         String    @map("church_id") @db.Uuid
  contentItemId    String?   @map("content_item_id") @db.Uuid
  caption          String
  title            String?
  mediaAssetIds    String[]  @default([]) @map("media_asset_ids") @db.Uuid
  thumbnailAssetId String?   @map("thumbnail_asset_id") @db.Uuid
  scheduledAt      DateTime? @map("scheduled_at") // UTC
  timezone         String? // IANA zone the user scheduled in (display context only)
  status           String
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  church       Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  contentItem  ContentItem?        @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  publications SocialPublication[]

  @@index([churchId, createdAt(sort: Desc)])
  @@index([churchId, status])
  @@index([contentItemId]) // FK lookups
  @@index([status, scheduledAt]) // due-post dispatcher
  @@map("social_posts")
}

// One row per platform/connection a post is published to; each publishes and fails independently.
model SocialPublication {
  id               String    @id @db.Uuid
  churchId         String    @map("church_id") @db.Uuid
  socialPostId     String    @map("social_post_id") @db.Uuid
  connectionId     String    @map("connection_id") @db.Uuid
  platform         String
  status           String
  providerPostId   String?   @map("provider_post_id")
  providerRef      String?   @map("provider_ref") // in-flight handle while the provider processes media
  permalink        String?
  attemptCount     Int       @default(0) @map("attempt_count")
  pollCount        Int       @default(0) @map("poll_count")
  lastErrorCode    String?   @map("last_error_code")
  lastErrorMessage String?   @map("last_error_message")
  outcomeUnknown   Boolean   @default(false) @map("outcome_unknown") // never retried automatically
  settings         Json      @default("{}") // per-target options chosen by the user (privacy, tags…)
  providerMetadata Json      @default("{}") @map("provider_metadata")
  metrics          Json?
  metricsUpdatedAt DateTime? @map("metrics_updated_at")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  church     Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  post       SocialPost       @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([socialPostId, connectionId]) // one publication per target; the idempotency anchor
  @@index([churchId, status])
  @@index([connectionId]) // FK lookups
  @@index([status, updatedAt]) // stale-publication sweep
  @@index([status, publishedAt]) // metrics refresh
  @@map("social_publications")
}

// Append-only audit trail: connect, disconnect, schedule, publish.
model SocialAuditLog {
  id            String   @id @db.Uuid
  churchId      String   @map("church_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String
  connectionId  String?  @map("connection_id") @db.Uuid
  socialPostId  String?  @map("social_post_id") @db.Uuid
  publicationId String?  @map("publication_id") @db.Uuid
  detail        Json     @default("{}") // never contains tokens or OAuth payloads
  createdAt     DateTime @default(now()) @map("created_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, createdAt])
  @@map("social_audit_logs")
}

model ReelCandidate {
  id          String   @id @db.Uuid
  churchId    String   @map("church_id") @db.Uuid
  sermonId    String   @map("sermon_id") @db.Uuid
  rank        Int
  title       String
  startTimeMs Int      @map("start_time_ms")
  endTimeMs   Int      @map("end_time_ms")
  transcript  String // what the pastor says in the window, taken from the transcript
  reason      String
  scores      Json // { standalone, impact, quotability, contextIndependence } (1–10)
  score       Float
  createdAt   DateTime @default(now()) @map("created_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([sermonId, rank])
  @@index([churchId, sermonId])
  @@map("reel_candidates")
}

model Reel {
  id                String     @id @db.Uuid
  churchId          String     @map("church_id") @db.Uuid
  sermonId          String     @map("sermon_id") @db.Uuid
  candidateId       String?    @map("candidate_id") @db.Uuid // candidates are replaced on regeneration, so no FK
  title             String
  startTimeMs       Int        @map("start_time_ms")
  endTimeMs         Int        @map("end_time_ms")
  transcript        String
  hookText          String?    @map("hook_text")
  hookStyle         String?    @map("hook_style")
  hookOptions       Json       @default("[]") @map("hook_options")
  captionStyle      String     @map("caption_style")
  captionPosition   String     @map("caption_position")
  status            ReelStatus
  progress          Int        @default(0)
  renderAttempt     Int        @default(0) @map("render_attempt")
  editedSinceRender Boolean    @default(false) @map("edited_since_render")
  outputAssetId     String?    @map("output_asset_id") @db.Uuid // media_assets row (VIDEO); kept if the Reel is deleted
  thumbnailAssetId  String?    @map("thumbnail_asset_id") @db.Uuid
  durationMs        Int?       @map("duration_ms")
  sizeBytes         BigInt?    @map("size_bytes")
  errorMessage      String?    @map("error_message")
  approvedAt        DateTime?  @map("approved_at")
  renderRequestedAt DateTime?  @map("render_requested_at")
  renderedAt        DateTime?  @map("rendered_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@index([churchId, createdAt(sort: Desc)])
  @@index([churchId, sermonId])
  @@index([churchId, status])
  @@index([sermonId]) // FK lookups / cascade deletes
  @@index([status, updatedAt]) // stuck-render sweep
  @@map("reels")
}
