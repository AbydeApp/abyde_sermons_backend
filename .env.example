# ── APP_* ───────────────────────────────────────────────────────────────
APP_ENV=development                        # development | test | staging | production
APP_PORT=4000
APP_CORS_ORIGINS=http://localhost:3001     # comma-separated allowlist of web-app origins (credentials enabled)
APP_WEB_URL=http://localhost:3001          # used for password-reset links, billing and OAuth redirects
APP_PUBLIC_API_URL=http://localhost:4000/api/v1   # public base URL of this API (OAuth callbacks)
# APP_SWAGGER_ENABLED=true                 # defaults to true outside production (/docs)
APP_LOG_LEVEL=info                         # fatal|error|warn|info|debug|trace|silent
APP_RATE_LIMIT_TTL_MS=60000                # global rate-limit window
APP_RATE_LIMIT_MAX=300                     # requests per window per client IP (the web app polls status every 2s)
APP_TRUST_PROXY_HOPS=1                     # proxies in front of the API (for client IPs)
APP_SHUTDOWN_DRAIN_MS=5000                 # pre-stop delay on SIGTERM so the load balancer stops routing first
APP_AI_RATE_LIMIT_MAX=20                   # per-IP requests/minute on AI endpoints (semantic search, ask)

# ── DATABASE_* / REDIS_* ────────────────────────────────────────────────
DATABASE_URL=postgresql://abyde:abyde_dev_password@localhost:5433/abyde_sermon
DATABASE_POOL_MAX=10                       # explicit: pool x replicas (API + workers + migration job + deploy overlap) must fit max_connections
# DATABASE_EXPECTED_PROCESSES=11            # peak processes with a pool; required in staging/production (boot fails if pool x this > max_connections)
DATABASE_STATEMENT_TIMEOUT_MS=15000        # server-side statement timeout
REDIS_URL=redis://localhost:6380

# ── AUTH_* ──────────────────────────────────────────────────────────────
AUTH_COOKIE_NAME=abyde_session
# AUTH_COOKIE_DOMAIN=.abyde.app            # set when web and API share a parent domain
# AUTH_COOKIE_SECURE=true                  # defaults to true outside development/test
AUTH_SESSION_TTL_HOURS=24
AUTH_REMEMBER_TTL_DAYS=30                  # session lifetime when "remember me" is ticked
AUTH_RESET_TOKEN_TTL_MINUTES=60
AUTH_RATE_LIMIT_MAX=10                     # per-IP requests/minute on login/register/reset endpoints

# ── STORAGE_* (S3-compatible: AWS S3, Cloudflare R2, local RustFS) ─────
STORAGE_PROVIDER=s3                        # any S3-compatible store
STORAGE_ENDPOINT=http://localhost:9000     # omit for AWS S3; https://<account>.r2.cloudflarestorage.com for R2
STORAGE_REGION=auto
STORAGE_BUCKET=abyde-sermon-dev
STORAGE_ACCESS_KEY_ID=abyde
STORAGE_SECRET_ACCESS_KEY=abyde_dev_password
STORAGE_FORCE_PATH_STYLE=true              # true for RustFS/MinIO

# ── AI_* / TRANSCRIPTION_* ──────────────────────────────────────────────
AI_PROVIDER=fake                           # openai | fake (fake = deterministic, no API key)
# AI_OPENAI_API_KEY=
AI_TEXT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small  # must produce 1536-dim vectors
AI_TEXT_INPUT_COST_PER_MTOK=0.4            # USD per 1M tokens, for cost logging
AI_TEXT_OUTPUT_COST_PER_MTOK=1.6
AI_EMBEDDING_COST_PER_MTOK=0.02
TRANSCRIPTION_PROVIDER=fake                # openai | fake
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_COST_PER_MINUTE=0.006
TRANSCRIPTION_FFMPEG_PATH=ffmpeg
TRANSCRIPTION_FFPROBE_PATH=ffprobe

# ── WORKER_* ────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_GRACE_MS=1800000            # running jobs get this long after SIGTERM; keep <= the platform's grace period
# WORKER_TMP_DIR=/tmp                      # scratch space for media processing

# ── BILLING_* (Paystack) ────────────────────────────────────────────────
BILLING_PROVIDER=fake                      # paystack | fake
# BILLING_PAYSTACK_SECRET_KEY=
# BILLING_PAYSTACK_PLAN_STARTER=PLN_xxx
# BILLING_PAYSTACK_PLAN_GROWTH=PLN_xxx
# BILLING_PAYSTACK_PLAN_MINISTRY=PLN_xxx

# ── EMAIL_* ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=outbox                      # resend | outbox (outbox writes emails to EMAIL_OUTBOX_DIR)
# EMAIL_RESEND_API_KEY=
EMAIL_FROM="Abyde Sermon <no-reply@abyde.app>"
EMAIL_OUTBOX_DIR=.outbox

# ── PUBLISHING_* (integrations) ─────────────────────────────────────────
# PUBLISHING_ENCRYPTION_KEY=               # 32 random bytes, base64 (openssl rand -base64 32); required in production
# PUBLISHING_META_APP_ID=
# PUBLISHING_META_APP_SECRET=
PUBLISHING_META_GRAPH_VERSION=v21.0
# PUBLISHING_GOOGLE_CLIENT_ID=
# PUBLISHING_GOOGLE_CLIENT_SECRET=
# PUBLISHING_MAILCHIMP_CLIENT_ID=
# PUBLISHING_MAILCHIMP_CLIENT_SECRET=

# ── STORAGE delivery for social providers ───────────────────────────────
# STORAGE_PUBLIC_BASE_URL=https://media.abyde.app   # optional public host serving only churches/*/sermons/*/generated/*
#                                                  # (needed for TikTok, which pulls media from a verified domain)

# ── SOCIAL_* (direct publishing: Meta, TikTok, YouTube, X, LinkedIn) ────
# SOCIAL_TOKEN_ENCRYPTION_KEY=               # 32 random bytes, base64; separate from PUBLISHING_ENCRYPTION_KEY; required in staging/production once a provider is set
# SOCIAL_TOKEN_ENCRYPTION_KEYS_PREVIOUS=     # comma-separated retired keys, accepted for decryption during a rotation
SOCIAL_MEDIA_URL_TTL_SECONDS=21600           # how long a provider may fetch a signed media URL
SOCIAL_HTTP_TIMEOUT_MS=30000                 # per provider call (one attempt; the queue owns retries)
# SOCIAL_META_APP_ID=                        # Facebook Pages + Instagram professional accounts
# SOCIAL_META_APP_SECRET=
SOCIAL_META_GRAPH_VERSION=v21.0
# SOCIAL_TIKTOK_CLIENT_KEY=
# SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_TIKTOK_AUDITED=false                  # until TikTok approves the app every post is private (SELF_ONLY)
# SOCIAL_GOOGLE_CLIENT_ID=                   # YouTube (Shorts are ordinary vertical uploads)
# SOCIAL_GOOGLE_CLIENT_SECRET=
# SOCIAL_X_CLIENT_ID=
# SOCIAL_X_CLIENT_SECRET=
# SOCIAL_LINKEDIN_CLIENT_ID=
# SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_API_VERSION=202609           # LinkedIn-Version header (YYYYMM); versions sunset after ~1 year
SOCIAL_LINKEDIN_ORGANIZATIONS=false          # true once LinkedIn approves Community Management API (Page posting)
# OAuth redirect URI to register with each provider: <APP_PUBLIC_API_URL>/social/oauth/<meta|tiktok|youtube|x|linkedin>/callback

# ── MEDIA_* (branded images and clips, rendered in the worker) ──────────
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_MAX_CLIP_SECONDS=180
MEDIA_REEL_MIN_SECONDS=15                  # shortest Reel (candidates and custom windows)
MEDIA_REEL_MAX_SECONDS=90                  # longest Reel
MEDIA_REEL_HOOK_SECONDS=3                  # how long the animated hook stays on screen
MEDIA_REEL_OUTRO_SECONDS=2.5               # branded end card appended after the sermon moment
MEDIA_SPEAKER_TRACKER=center               # center | command (smart vertical crop; failures fall back to centre)
# MEDIA_SPEAKER_TRACKER_COMMAND=python3 scripts/speaker-tracking/track_speaker.py
MEDIA_SPEAKER_TRACKER_TIMEOUT_MS=180000
MEDIA_SPEAKER_TRACKER_FPS=2                # frames analysed per second of video

# ── OBSERVABILITY_* ─────────────────────────────────────────────────────
# OBSERVABILITY_METRICS_TOKEN=             # bearer token for GET /metrics (required to expose metrics in production)
# OBSERVABILITY_SENTRY_DSN=
# OBSERVABILITY_TRACES_SAMPLE_RATE=0.1     # share of requests traced (0–1)
